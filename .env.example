# ForgeHub server configuration (example — copy to .env, never commit .env)
# All values are documented in docs/running.md.
FORGEHUB_ENV=dev
FORGEHUB_BIND=127.0.0.1:8080
FORGEHUB_BASE_URL=http://127.0.0.1:8080
FORGEHUB_DATABASE_URL=sqlite://forgehub.db
# FORGEHUB_SECRET_KEY must be >= 32 bytes in production; generate with a CSPRNG.
FORGEHUB_SECRET_KEY=change-me-in-production-at-least-32-bytes
FORGEHUB_ALLOW_SIGNUP=true
# Directory containing the built web app (index.html + assets).
FORGEHUB_WEB_DIR=web/dist
# Max API request body, KiB (default 256).
FORGEHUB_BODY_LIMIT_KIB=256
# Per-token/IP request budget per minute (default 600).
FORGEHUB_RATE_LIMIT_PER_MINUTE=600
# API request timeout, seconds (default 30).
FORGEHUB_REQUEST_TIMEOUT_SECS=30
# Log filter (tracing EnvFilter syntax); prod logs are JSON.
RUST_LOG=forge_server=info
