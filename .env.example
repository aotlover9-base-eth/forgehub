# ForgeHub server configuration (example — copy to .env, never commit .env)
# All values are documented in docs/running.md from Step 6 onward.
FORGEHUB_ENV=dev
FORGEHUB_BIND=127.0.0.1:8080
FORGEHUB_BASE_URL=http://127.0.0.1:8080
FORGEHUB_DATABASE_URL=sqlite://forgehub.db
# FORGEHUB_SECRET_KEY must be >= 32 bytes in production; generate with a CSPRNG.
FORGEHUB_SECRET_KEY=change-me-in-production-at-least-32-bytes
FORGEHUB_ALLOW_SIGNUP=true
