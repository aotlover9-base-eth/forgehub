# ForgeHub behind Caddy: automatic HTTPS (Let's Encrypt) for
# {$FORGEHUB_DOMAIN}, reverse-proxied to the server container.
# Caddy terminates TLS, so the app's Secure cookies apply, and
# adds HSTS at the edge (the app itself sets CSP and the other
# security headers — see docs/security.md).

{$FORGEHUB_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy forgehub:8080
}
